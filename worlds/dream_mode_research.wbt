FpvResearchQuad {
  translation -7 0 0.03
  rotation 0 0 1 0
  name "Dream Mode Drone"
  supervisor TRUE
  extensionSlot [
    Accelerometer {
    }
    Camera {
      translation 0.065 0 0.02
      rotation 0 1 0 -0.3839724354387525
      name "research camera"
      fieldOfView 2.0943951
      width 480
      height 270
      near 0.05
    }
    # DJI O4 Air Unit / Goggles 3 Racing Mode visual reference. The live
    # Viewpoint uses the same FOV; this camera preserves outage anchors.
    Camera {
      translation 0.065 0 0.02
      rotation 0 1 0 -0.3839724354387525
      name "pilot digital camera"
      fieldOfView 2.052507200345331
      width 480
      height 270
      near 0.05
      exposure 1
      antiAliasing TRUE
      bloomThreshold -1
      motionBlur 0
      noise 0
    }
    # Good-link Foxeer Predator 5 NTSC/CVBS reference through a modern
    # deinterlaced receiver. Link breakup is an experimental condition, not a
    # permanent VHS-style overlay on the healthy feed.
    Camera {
      translation 0.065 0 0.02
      rotation 0 1 0 -0.3839724354387525
      name "pilot analog camera"
      fieldOfView 2.181661564992912
      width 480
      height 270
      near 0.05
      exposure 1.05
      antiAliasing TRUE
      bloomThreshold -1
      motionBlur 4
      noise 0.006
      lens Lens {
        radialCoefficients -0.035 0.008
      }
    }
    Display {
      translation 0.1122863766 0 0.0391049363
      rotation 0 1 0 -0.3839724354387525
      name "pilot display"
      width 480
      height 270
      children [
        Shape {
          appearance PBRAppearance {
            baseColorMap ImageTexture {
              filtering 0
            }
            roughness 1
            metalness 0
          }
          geometry IndexedFaceSet {
            coord Coordinate {
              point [
                0 0.142222 0.08
                0 0.142222 -0.08
                0 -0.142222 -0.08
                0 -0.142222 0.08
              ]
            }
            texCoord TextureCoordinate {
              point [
                0 1
                0 0
                1 0
                1 1
              ]
            }
            coordIndex [
              0, 1, 2, 3
            ]
            texCoordIndex [
              0, 1, 2, 3
            ]
          }
        }
      ]
    }
    RangeFinder {
      translation 0.065 0 0.02
      rotation 0 1 0 -0.3839724354387525
      name "depth"
      fieldOfView 2.0943951
      width 320
      height 180
      near 0.05
      minRange 0.05
      maxRange 20
    }
  ]
